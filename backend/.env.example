# Copy this file to .env (same folder) and fill in the real values. Never commit .env.

NODE_ENV=development
PORT=3001

# MongoDB Atlas connection string: Atlas > your cluster > Connect > Drivers.
# Replace <user> and <password>, and keep /basketna before the "?" so the data goes into the basketna database.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/basketna?retryWrites=true&w=majority

# Database the API tests use. The tests DELETE everything in it, so its name must end with _test.
TEST_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/basketna_test?retryWrites=true&w=majority

# The React dev server (npm run dev in client/), allowed by CORS.
CLIENT_URL=http://localhost:5173
