{
  "name": "basketna-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Basketna REST API: weekly Egyptian meal plans and whole-basket price comparison (Express + MongoDB Atlas).",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --env-file-if-exists=.env src/cli.js seed ../data/egypt_cairo.json",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1"
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "mongoose": "8.9.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "supertest": "7.1.3"
  },
  "engines": {
    "node": ">=22.9"
  }
}
